# /etc/systemd/system/prize-draw-crank.service — the prize-draw crank: draws each round from its
# drand beacon once that beacon is published, and refunds a round only if nobody could draw it.
#
# Modelled on block-history-feeder.service, which has been running this shape on a DigitalOcean
# droplet since 2026-09. Install it, but DO NOT enable it here: ENABLING IT STARTS SENDING MAINNET
# TRANSACTIONS, so that step belongs to the operator, after the module is deployed and the crank's
# account is funded:
#   systemctl enable --now prize-draw-crank
#   journalctl -u prize-draw-crank -f
#
# Started too early it is harmless: with no module deployed, or no KDA on the key, it fails its
# own startup checks and exits without sending anything.
#
# WHAT THIS PROCESS CAN AND CANNOT DO. Every call it makes is permissionless — the draw itself,
# `escape`, `claim-escape`. It holds no operator or admin authority, cannot choose a
# winner, and cannot move money anywhere the contract would not send it anyway. A stolen crank key
# costs what its own account holds: the gas and, with DRAW_PAYEE unset (the default), every
# drawer's share it has earned and not moved out. With DRAW_PAYEE set, it holds the gas alone.

[Unit]
Description=prize-draw crank (draws each round from its drand beacon and settles it)
After=network-online.target
Wants=network-online.target
# A persistent misconfiguration (an unfunded key, the module not yet deployed) makes the crank exit
# at startup. Without a limit systemd would restart it forever and hammer the public node with
# reads. Five failed starts in 30 minutes stops it until someone looks.
StartLimitIntervalSec=1800
StartLimitBurst=5

[Service]
Type=simple
User=prizedraw
Group=prizedraw
# The code is root's; the service can only READ it, so a compromised crank cannot rewrite what it
# runs. The only thing the service user owns is its key directory, /etc/prize-draw.
WorkingDirectory=/opt/prize-draw-crank
Environment=NODE_ENV=production
# MAINNET INTERLOCKS. crank.mjs refuses to touch mainnet unless every one of these is set
# deliberately; none of them has a default that could be inherited from a devnet session.
Environment=DRAW_MAINNET=armed
Environment=DEVNET_NETWORK_ID=mainnet01
Environment=DEVNET_HOST=https://chainweb.eckowallet.com
Environment=CHAIN_ID=2
Environment=DRAW_NS=n_48867b242317a0216a67f8c7ca26696b5878e0e3
# The key file lives OUTSIDE the checkout, and that is enforced: crank.mjs refuses a key file
# anywhere under this checkout (/opt/prize-draw-crank), so the key lives in /etc, not /opt.
Environment=DRAW_ACCOUNTS=/etc/prize-draw/crank-key.json
Environment=DRAW_BOT=crank
# Pace. The crank sleeps until the next thing that could need doing — a round's close, then the
# moment drand publishes the round's beacon, both of which it knows from the chain — and polls at
# POLL_MS only when that moment is close. MAX_SLEEP_MS caps a long sleep, which is what bounds how
# late a round re-scheduled to draw EARLIER could be picked up.
Environment=POLL_MS=2500
Environment=MAX_SLEEP_MS=300000
# LEADER OR FOLLOWER. The production pair runs two cranks on separate machines: this unit ships
# every crank as the LEADER (0: act as soon as a round is drawable). On the SECOND machine only,
# put CRANK_FOLLOWER_MS=90000 in /etc/prize-draw/crank.env: that crank then waits 90 s after it
# first sees a round drawable, re-reads the round, and acts only if the leader has not settled it.
Environment=CRANK_FOLLOWER_MS=0
# Every call to the node gives up after this long. A failed call fails that pass, and the heartbeat
# is withheld until a pass completes cleanly.
Environment=NODE_TIMEOUT_MS=30000

# YOUR SETTINGS GO IN A FILE, NOT IN THIS UNIT. Everything above is a shipped
# default that an update overwrites; /etc/prize-draw/crank.env is yours and is
# never touched by an update. systemd documents these as overriding Environment=
# above whatever the order, so anything you put there wins.
#   DRAW_PAYEE=k:…          where this bot's earnings are paid — set it to a cold
#                           account and the hot key here only ever holds gas
#   HEARTBEAT_URL=https://… a ping URL that alerts when the pings STOP
#   CRANK_FOLLOWER_MS=90000 on the second crank of a pair only (see above)
# The leading `-` means the unit still starts when the file does not exist.
EnvironmentFile=-/etc/prize-draw/crank.env
ExecStart=/usr/local/bin/node crank.mjs
Restart=always
RestartSec=30
# A leak must not take the whole machine down with it. MEASURED 2026-09-18: the crank sits at
# 88 MB RSS, flat, while watching four raffles. The cap is ~2x that, deliberately well under the
# 512 MB droplet it runs on: past this systemd kills and restarts it (RestartSec=30) instead of
# letting the box swap itself to a standstill. Raise it only with a new measurement.
MemoryMax=200M

# The crank holds a hot key with a gas balance, and its earnings too unless DRAW_PAYEE sends them
# elsewhere. Unprivileged user; the file system is read-only to it. It never needs to write its
# key, so it cannot alter it.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
# Deliberately NOT set: MemoryDenyWriteExecute, which breaks V8's JIT.

[Install]
WantedBy=multi-user.target
